root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.rb]
indent_size = 2

[Gemfile]
indent_size = 2

[*.csv]
trim_trailing_whitespace = false
insert_final_newline = false
